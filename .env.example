# Copy to .env for local ergonomics (`set -a; source .env; set +a` in bash/zsh).
# Never commit real secrets.

# --- Local development defaults (explicit opt-in)
# Matches README quickstart when combined with `--dev`.
# AGENT_GOV_DEV=1
# AGENT_GOV_TOKEN=dev-token

# Production-style: omit AGENT_GOV_DEV and supply strong secrets.
# AGENT_GOV_TOKEN=
# AGENT_GOV_CONTEXT_SECRET=

# SQLite persistence for server snapshots (-p agent-governance-server or `agent-governance server --db`).
# AGENT_GOV_DB=./agent-governance.sqlite

# Optional council pack path (otherwise embedded default pack).
# AGENT_GOV_COUNCIL_PACK=./packs/default/council.json

# Used by CLI `context sign` outside dev mode.
# AGENT_GOV_CONTEXT_SECRET=
