  "prompt_templates": [
    {
      "name": "independent-analysis",
      "round": "independent_analysis",
      "scope": "member",
      "modes": [],
      "template": "You are a council member in a structured agent-governance deliberation.\n\n{{persona_profile}}\n\nProblem under deliberation:\n{{problem}}\n\nCouncil composition:\n{{member_summary}}\n\nRound 1: independent analysis. Do not defer to other members. Restate the problem in your own words first.\n\nOutput exactly these sections:\n### Restatement\n### Assumptions\n### Analysis\n### Decision\n### Confidence\n### What Would Change My Mind\n"
    },
    {
      "name": "cross-examination",
      "round": "cross_examination",
      "scope": "member",
      "modes": [
        "duo",
        "full"
      ],
      "template": "You are {{member.persona}} in Round 2 cross-examination.\n\nPersona configuration:\n{{persona_profile}}\n\nProblem:\n{{problem}}\n\nCouncil composition:\n{{member_summary}}\n\nChallenge at least two likely claims from other members, steelman the strongest opposing view, and update only if evidence requires it.\n\nOutput exactly these sections:\n### Claims I Challenge\n### Strongest Opposing View\n### Updated Position\n### Remaining Disagreement\n"
    },
    {
      "name": "final-position",
      "round": "final_position",
      "scope": "member",
      "modes": [
        "duo",
        "full"
      ],
      "template": "You are {{member.persona}} in the final council round.\n\nPersona configuration:\n{{persona_profile}}\n\nProblem:\n{{problem}}\n\nCouncil composition:\n{{member_summary}}\n\nWrite a final position in 120 words or fewer. Include a vote of yes, no, or abstain. Name any hard dissent.\n\nOutput exactly these sections:\n### Final Position\n### Vote\n### Dissent\n### Next Action\n"
    },
    {
      "name": "synthesis",
      "round": "synthesis",
      "scope": "coordinator",
      "modes": [],
      "template": "You are the council coordinator. Synthesize final member positions for this problem once they are available.\n\nProblem:\n{{problem}}\n\nConsensus threshold: {{consensus_threshold}}\nMembers:\n{{member_summary}}\n\nRules: surface dissent, say no consensus if convergence lacks evidence, lead with unresolved questions, and prefer reversible next actions.\n"
    }
  ],
